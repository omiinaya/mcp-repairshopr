# =============================================================================
# MCP RepairShopr Server Environment Configuration
# =============================================================================
# Copy this file to .env and configure for your environment
# This file is optimized for Coolify deployment with detailed descriptions
# =============================================================================

# =============================================================================
# SERVER CONFIGURATION (Required)
# =============================================================================
# These variables are required for server operation

# SERVER_NAME
# Description: Human-readable name for this server instance
# Default: mcp-repairshopr
# Required: Yes
# Example: mcp-repairshopr-prod
SERVER_NAME=mcp-repairshopr

# SERVER_VERSION
# Description: Version of the MCP server (should match package.json)
# Default: 0.1.0
# Required: Yes
# Example: 0.1.0
SERVER_VERSION=0.1.0

# PORT
# Description: Port number for the server to listen on
# Default: 3000
# Required: Yes (Coolify will override this)
# Note: Coolify automatically assigns a dynamic port
PORT=3000

# NODE_ENV
# Description: Environment mode for Node.js
# Default: production
# Required: Yes
# Values: development, production, test
# Note: Always use 'production' for Coolify deployments
NODE_ENV=production

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
# Control how logs are formatted and what level is captured

# LOG_LEVEL
# Description: Minimum log level to capture
# Default: info
# Required: No
# Values: error, warn, info, debug, trace
# Note: Use 'debug' or 'trace' for troubleshooting
LOG_LEVEL=info

# LOG_FORMAT
# Description: Format for log output
# Default: json
# Required: No
# Values: json, plain
# Note: JSON format is recommended for Coolify log aggregation
LOG_FORMAT=json

# =============================================================================
# CACHE CONFIGURATION
# =============================================================================
# Control caching behavior for improved performance

# CACHE_MAX_SIZE
# Description: Maximum cache size in bytes
# Default: 10485760 (10 MB)
# Required: No
# Example: 10485760
CACHE_MAX_SIZE=10485760

# CACHE_DEFAULT_TTL
# Description: Default cache time-to-live in milliseconds
# Default: 300000 (5 minutes)
# Required: No
# Example: 300000
CACHE_DEFAULT_TTL=300000

# CACHE_MAX_ENTRIES
# Description: Maximum number of entries in cache
# Default: 1000
# Required: No
# Example: 1000
CACHE_MAX_ENTRIES=1000

# CACHE_ENABLE_WARMING
# Description: Enable cache warming on startup for better initial performance
# Default: true
# Required: No
# Values: true, false
CACHE_ENABLE_WARMING=true

# =============================================================================
# PERFORMANCE CONFIGURATION
# =============================================================================
# Tune server performance for your workload

# MAX_CONCURRENT_REQUESTS
# Description: Maximum number of concurrent requests the server can handle
# Default: 100
# Required: No
# Example: 100
# Note: Adjust based on expected traffic and available resources
MAX_CONCURRENT_REQUESTS=100

# REQUEST_TIMEOUT
# Description: Request timeout in milliseconds
# Default: 30000 (30 seconds)
# Required: No
# Example: 30000
REQUEST_TIMEOUT=30000

# ENABLE_METRICS
# Description: Enable metrics collection for monitoring
# Default: true
# Required: No
# Values: true, false
ENABLE_METRICS=true

# ENABLE_HOT_RELOAD
# Description: Enable configuration hot-reload without restart
# Default: false
# Required: No
# Values: true, false
# Warning: Not recommended for production use
ENABLE_HOT_RELOAD=false

# =============================================================================
# DATA DIRECTORY CONFIGURATION
# =============================================================================
# Configure paths for data and configuration files

# DATA_DIR
# Description: Directory for data files (relative to container)
# Default: ./data
# Required: No
# Note: This directory should be mounted as a volume for persistence
DATA_DIR=./data

# CONFIG_DIR
# Description: Directory for configuration files (relative to container)
# Default: ./config
# Required: No
CONFIG_DIR=./config

# METADATA_INDEX_PATH
# Description: Path to the metadata index file
# Default: ./data/metadata-index.json
# Required: No
METADATA_INDEX_PATH=./data/metadata-index.json

# =============================================================================
# HEALTH CHECK CONFIGURATION
# =============================================================================
# Configure health check behavior for Coolify monitoring

# HEALTH_CHECK_INTERVAL
# Description: Interval between health checks in milliseconds
# Default: 60000 (1 minute)
# Required: No
# Example: 60000
HEALTH_CHECK_INTERVAL=60000

# HEALTH_CHECK_TIMEOUT
# Description: Health check timeout in milliseconds
# Default: 5000 (5 seconds)
# Required: No
# Example: 5000
HEALTH_CHECK_TIMEOUT=5000

# =============================================================================
# MONITORING CONFIGURATION
# =============================================================================
# Configure built-in monitoring and metrics

# MONITORING_ENABLED
# Description: Enable the monitoring service
# Default: true
# Required: No
# Values: true, false
MONITORING_ENABLED=true

# MONITORING_INTERVAL
# Description: Monitoring data collection interval in milliseconds
# Default: 60000 (1 minute)
# Required: No
# Example: 60000
MONITORING_INTERVAL=60000

# =============================================================================
# COOLIFY RESOURCE LIMITS
# =============================================================================
# Configure resource limits for Coolify container management
# These are used by Coolify's resource management system

# CPU_LIMIT
# Description: Maximum CPU cores allocated to the container
# Default: 1.0
# Required: No
# Example: 1.0
# Note: Can be a decimal (e.g., 0.5 for half a core)
CPU_LIMIT=1.0

# MEMORY_LIMIT
# Description: Maximum memory allocated to the container
# Default: 512M
# Required: No
# Example: 512M, 1G
# Note: Use M for megabytes, G for gigabytes
MEMORY_LIMIT=512M

# CPU_RESERVATION
# Description: Guaranteed minimum CPU cores
# Default: 0.5
# Required: No
# Example: 0.5
CPU_RESERVATION=0.5

# MEMORY_RESERVATION
# Description: Guaranteed minimum memory
# Default: 256M
# Required: No
# Example: 256M, 512M
MEMORY_RESERVATION=256M

# =============================================================================
# REPAIRSHOPR API CONFIGURATION (Optional)
# =============================================================================
# Configure access to RepairShopr live API for making actual API calls
# These are optional - if not provided, server will only provide documentation

# REPAIRSHOPR_API_KEY
# Description: Your RepairShopr API key for live API access
# Default: (none)
# Required: No
# Note: Get from https://YOUR_SUBDOMAIN.repairshopr.com/api
# Warning: Keep this secret! Do not commit to version control
REPAIRSHOPR_API_KEY=your_api_key_here

# REPAIRSHOPR_SUBDOMAIN
# Description: Your RepairShopr subdomain (e.g., 'mycompany' for mycompany.repairshopr.com)
# Default: (none)
# Required: No (only if using REPAIRSHOPR_API_KEY)
REPAIRSHOPR_SUBDOMAIN=your_subdomain_here

# REPAIRSHOPR_TIMEOUT_MS
# Description: Timeout for RepairShopr API requests in milliseconds
# Default: 30000
# Required: No
REPAIRSHOPR_TIMEOUT_MS=30000

# REPAIRSHOPR_RETRY_ATTEMPTS
# Description: Number of retry attempts for failed API requests
# Default: 3
# Required: No
REPAIRSHOPR_RETRY_ATTEMPTS=3

# REPAIRSHOPR_RETRY_DELAY_MS
# Description: Delay between retry attempts in milliseconds
# Default: 1000
# Required: No
REPAIRSHOPR_RETRY_DELAY_MS=1000
