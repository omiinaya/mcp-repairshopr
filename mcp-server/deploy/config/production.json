{
  "serverName": "mcp-repairshopr",
  "serverVersion": "0.1.0",
  "port": 3000,
  "logLevel": "info",
  "logFormat": "json",
  "enableHotReload": false,
  "enableMetrics": true,
  "maxConcurrentRequests": 100,
  "requestTimeout": 30000,
  "cache": {
    "maxSize": 10485760,
    "defaultTTL": 300000,
    "maxEntries": 1000,
    "enableWarming": true
  },
  "monitoring": {
    "enabled": true,
    "interval": 60000,
    "healthCheckInterval": 60000,
    "healthCheckTimeout": 5000
  },
  "data": {
    "dataDir": "./data",
    "configDir": "./config",
    "metadataIndexPath": "./data/metadata-index.json"
  },
  "api": {
    "timeout": 30000,
    "retryAttempts": 3,
    "retryDelay": 1000
  }
}
